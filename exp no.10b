SQL> SET SERVEROUTPUT ON;
SQL> DECLARE
  2  N NUMBER;
  3  BEGIN
  4  N := &N;
  5  IF N > 0 THEN
  6  DBMS_OUTPUT.PUT_LINE('The number is Positive');
  7  ELSIF N < 0 THEN
  8  DBMS_OUTPUT.PUT_LINE('The number is Negative');
  9  ELSE
 10  DBMS_OUTPUT.PUT_LINE('The number is Zero');
 11  END IF;
 12  END;
 13  /
Enter value for n: 25
old   4: N := &N;
new   4: N := 25;
The number is Positive
