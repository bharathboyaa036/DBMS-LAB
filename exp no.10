SQL> SET SERVEROUTPUT ON;
SQL> DECLARE
  2  V_NUM NUMBER;
  3  BEGIN
  4  V_NUM := 10/0;
  5  EXCEPTION
  6  WHEN OTHERS THEN
  7  DBMS_OUTPUT.PUT_LINE('SQLCODE : ' || SQLCODE);
  8  DBMS_OUTPUT.PUT_LINE('SQLERRM : ' || SQLERRM);
  9  END;
 10  /
SQLCODE : -1476
SQLERRM : ORA-01476: divisor is equal to zero

