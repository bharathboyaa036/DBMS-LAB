SQL> create table student(
  2  reg_number varchar2(10),
  3  name varchar2(10),
  4  age number(5),
  5  email varchar2(25));

Table created.

SQL> alter table student modify(
  2  reg_number varchar2(10) primary key,
  3  name varchar2(10) not null,
  4  age number(2) check(age>=18),
  5  email varchar2(25) unique);

Table altered.

